# Backend-engineer agent image: credential-free by construction — the
# pod holds no secret at all: its gateway credential is a projected
# service-account token file.
# Lockfile-pinned build: deps from uv.lock via `uv export`.
# Build from the repo root: docker build -f Dockerfile.agent .
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /usr/local/bin/uv

WORKDIR /opt/poseidon
COPY pyproject.toml uv.lock ./
COPY packages/common/pyproject.toml packages/common/
COPY packages/agent/pyproject.toml packages/agent/
COPY packages/gateway/pyproject.toml packages/gateway/
COPY packages/gateway-llm/pyproject.toml packages/gateway-llm/
COPY packages/sandbox/pyproject.toml packages/sandbox/
COPY packages/orchestrator/pyproject.toml packages/orchestrator/
COPY packages/mockllm/pyproject.toml packages/mockllm/
COPY packages/registry/pyproject.toml packages/registry/
COPY packages/compiler/pyproject.toml packages/compiler/
COPY packages/operator/pyproject.toml packages/operator/
COPY packages/schema/pyproject.toml packages/schema/
RUN uv export --frozen --no-dev --no-emit-workspace --no-hashes --package agent \
      -o /tmp/requirements.txt \
    && pip install --no-cache-dir -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

COPY packages/common packages/common
COPY packages/agent packages/agent
RUN pip install --no-cache-dir --no-deps ./packages/common ./packages/agent

# The SDK is env-gated quiet: no banner, no Laminar telemetry (LMNR_* absent).
ENV OPENHANDS_SUPPRESS_BANNER=1

# Non-root runtime user; pod specs set runAsNonRoot/runAsUser to match.
RUN useradd --create-home --uid 10001 poseidon
USER 10001

EXPOSE 8000
CMD ["uvicorn", "--factory", "agent.app:create_app", "--host", "0.0.0.0", "--port", "8000"]
