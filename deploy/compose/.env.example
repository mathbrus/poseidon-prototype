# Poseidon PoC environment (contract C7). Copy to .env and fill in real values.
# `docker compose` loads this file from this directory automatically. The
# host-side runner does not — `set -a && source .env && set +a` from the repo
# root (or export the vars) before `uv run poseidon-poc …`. Values below are
# the host's view; in-network URLs are fixed in compose.

# Secrets — exist in exactly two containers
GIT_TOKEN=ghp_replace-with-repo-scoped-pat        # gateway only
LLM_API_KEY=sk-replace-with-provider-key          # llm-proxy only

# Run configuration
TARGET_REPO=github.com/example-org/example-repo
BASE_REF=main
MODEL=gpt-4o-mini
MAX_ITERATIONS=10

# Static bearer tokens (identity placeholders)
AGENT_BEARER_TOKEN=agent-token-placeholder
RUNNER_BEARER_TOKEN=runner-token-placeholder

# Service URLs as the host-side runner sees them: the gateway through its
# published port, the agent at its fixed address on the internal agentnet.
MCP_GATEWAY_URL=http://127.0.0.1:8080
AGENT_URL=http://172.28.10.10:8000

# In-network LLM proxy URL (informational; compose hardcodes it for the agent)
LLM_PROXY_URL=http://llm-proxy:4000

# Sandbox provisioning (runner): image built from Dockerfile.sandbox and the
# compose project's zero-egress sandbox network.
SANDBOX_IMAGE=poseidon-sandbox
SANDBOX_NETWORK=poseidon-sandboxnet
