# Poseidon's kind environment. Copy this file to deploy/kind/.env and set
# GIT_TOKEN. deploy/kind/kind-up.sh reads it, and so does
# scripts/acceptance.sh. To give the poseidon CLI the same values:
#   set -a && source deploy/kind/.env && set +a
#
# The docs site renders its environment-variable reference from this file:
# a `# ==` line opens a section, and the comment block above a variable
# describes it.

# == In this file

# A GitHub token that can push to the company's repository and manage its
# pull requests and issues. It reaches one pod: the MCP gateway.
GIT_TOKEN=ghp_replace-with-repo-scoped-pat

# `1` deploys a paid model through LiteLLM instead of the free mock brain.
# A value on the command line (`REAL_LLM=0 deploy/kind/kind-up.sh`) wins
# over this file.
#REAL_LLM=1

# The provider's API key, required with REAL_LLM=1. It reaches one pod: the
# llm-proxy.
#LLM_API_KEY=sk-replace-with-openai-key

# The model every agent uses, required with REAL_LLM=1.
#MODEL=gpt-5.6-luna

# The Postgres superuser for Temporal and the registry, inside the cluster.
# Optional: kind-up.sh fills in development defaults.
#POSTGRES_USER=poseidon
#POSTGRES_PASSWORD=

# The key the egress proxy signs per-run credentials with, inside the
# cluster. Optional: kind-up.sh fills in a development default.
#EGRESS_PROXY_KEY=

# `1` also deploys Temporal's web UI.
#TEMPORAL_WEB=1

# Where the host reaches the MCP gateway.
MCP_GATEWAY_URL=http://127.0.0.1:8080

# Where the host reaches the console. The CLI reads it from your shell, and
# uses this address when it is unset.
POSEIDON_CONSOLE_URL=http://127.0.0.1:8090

# The name kind-up.sh tags the platform's sandbox image with.
SANDBOX_IMAGE=poseidon-sandbox

# == In your shell
# Set these for the command you run, for example
# `VERBOSE=1 deploy/kind/kind-up.sh`.

# A console token. It wins over the one `poseidon login --save` keeps in
# ~/.config/poseidon/token.
#POSEIDON_TOKEN=

# `1` makes kind-up.sh stream every command's output instead of logging it.
#VERBOSE=1

# The kind cluster's name, for kind-up.sh and kind-down.sh.
#CLUSTER_NAME=poseidon

# The disposable repository the acceptance suite opens pull requests on.
#E2E_TARGET_REPO=github.com/you/disposable

# `1` lets the acceptance suite run against a paid model. It spends money:
# set it only on purpose.
#POSEIDON_ALLOW_PAID=1
