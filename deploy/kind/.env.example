# Poseidon kind environment. Copy to .env and fill in real
# values. deploy/kind/kind-up.sh sources this file to install the chart; the
# host-side runner and the acceptance suite read it too:
#   set -a && source deploy/kind/.env && set +a
#   uv run poseidon-poc run examples/task-happy.md

# Secrets — land in exactly two pods (gateway, llm-proxy) via the chart.
GIT_TOKEN=ghp_replace-with-repo-scoped-pat

# The LLM is MOCKED by default (deterministic poseidon-mockllm brain — runs
# cost nothing). Set REAL_LLM=1 to deploy the real LiteLLM proxy instead;
# only then are LLM_API_KEY and MODEL required.
#REAL_LLM=1
#LLM_API_KEY=sk-replace-with-provider-key
#MODEL=gpt-4o-mini

# Run configuration
TARGET_REPO=github.com/example-org/example-repo
BASE_REF=main
MAX_ITERATIONS=10

# Static bearer tokens (identity placeholders until step 12)

# Postgres superuser password (cluster-internal; Temporal + later the
# registry). Optional — kind-up.sh defaults it for dev.
#POSTGRES_PASSWORD=

# Shared HMAC key for per-run egress-proxy credentials (cluster-internal).
# Optional — kind-up.sh defaults it for dev.
#EGRESS_PROXY_KEY=

# Service URL as the host sees it: the kind extraPortMapping puts the
# gateway NodePort on the loopback under the familiar port. Standing agents
# have no NodePort (reached in-cluster only).
MCP_GATEWAY_URL=http://127.0.0.1:8080

# Sandbox image (sandboxes are Kubernetes Jobs in the company
# namespace; kind-up.sh builds and side-loads this image into the cluster).
SANDBOX_IMAGE=poseidon-sandbox
