# Poseidon kind environment (plan step 1). Copy to .env and fill in real
# values. deploy/kind/kind-up.sh sources this file to install the chart; the
# host-side runner and the E1 suite read it too:
#   set -a && source deploy/kind/.env && set +a
#   uv run poseidon-poc run examples/task-happy.md

# Secrets — land in exactly two pods (gateway, llm-proxy) via the chart
GIT_TOKEN=ghp_replace-with-repo-scoped-pat
LLM_API_KEY=sk-replace-with-provider-key

# Run configuration
TARGET_REPO=github.com/example-org/example-repo
BASE_REF=main
MODEL=gpt-4o-mini
MAX_ITERATIONS=10

# Static bearer tokens (identity placeholders until step 12)
AGENT_BEARER_TOKEN=agent-token-placeholder
RUNNER_BEARER_TOKEN=runner-token-placeholder

# Postgres superuser password (cluster-internal; Temporal + later the
# registry). Optional — kind-up.sh defaults it for dev.
#POSTGRES_PASSWORD=

# Service URLs as the host sees them: kind extraPortMappings put the gateway
# and agent NodePorts on the loopback under the familiar ports.
MCP_GATEWAY_URL=http://127.0.0.1:8080
AGENT_URL=http://127.0.0.1:8000

# Sandbox provisioning: sandboxes stay Docker containers on the host until
# the k8s_jobs backend (plan step 4). They attach to an internal (zero
# egress) Docker network that the kind node also joins, which is what lets
# the in-cluster gateway reach their toolservers.
SANDBOX_IMAGE=poseidon-sandbox
SANDBOX_NETWORK=poseidon-kind-sandboxnet
