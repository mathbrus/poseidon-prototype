# Mock LLM image: deterministic OpenAI-compatible brain standing in for the
# LiteLLM proxy so e2e runs cost nothing. Dev/test only — never a production
# component; the llm-proxy Deployment swaps to it via values-mockllm.yaml.
# Build from the repo root: docker build -f Dockerfile.mockllm .
FROM python:3.12-slim

COPY packages/mockllm /opt/poseidon/packages/mockllm
RUN pip install --no-cache-dir /opt/poseidon/packages/mockllm

# The llm-proxy template supplies LiteLLM-shaped args (--model ... --port 4000);
# the entry point accepts and ignores what it must.
ENTRYPOINT ["python", "-m", "mockllm"]
