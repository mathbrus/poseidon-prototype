# Sandbox image: toolchain prebaked because sandbox egress is proxy-only
# (and empty allowlists mean zero egress). pytest rides the sandbox
# package's `toolchain` extra so the whole image is lockfile-pinned:
# deps from uv.lock via `uv export`.
# Build from the repo root: docker build -f Dockerfile.sandbox .
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /usr/local/bin/uv

WORKDIR /opt/poseidon
COPY pyproject.toml uv.lock ./
COPY packages/common/pyproject.toml packages/common/
COPY packages/agent/pyproject.toml packages/agent/
COPY packages/gateway/pyproject.toml packages/gateway/
COPY packages/gateway-llm/pyproject.toml packages/gateway-llm/
COPY packages/sandbox/pyproject.toml packages/sandbox/
COPY packages/orchestrator/pyproject.toml packages/orchestrator/
COPY packages/mockllm/pyproject.toml packages/mockllm/
COPY packages/registry/pyproject.toml packages/registry/
COPY packages/compiler/pyproject.toml packages/compiler/
COPY packages/operator/pyproject.toml packages/operator/
COPY packages/schema/pyproject.toml packages/schema/
RUN uv export --frozen --no-dev --no-emit-workspace --no-hashes \
      --package sandbox --extra toolchain \
      -o /tmp/requirements.txt \
    && pip install --no-cache-dir -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

COPY packages/common packages/common
COPY packages/sandbox packages/sandbox
RUN pip install --no-cache-dir --no-deps ./packages/common ./packages/sandbox

# Identity for local commits made inside the sandbox (no credentials involved).
RUN git config --system user.name "poseidon-sandbox" \
    && git config --system user.email "sandbox@poseidon.local" \
    && git config --system --add safe.directory /workspace

WORKDIR /workspace

# Non-root runtime user; the Job spec sets runAsNonRoot/runAsUser to match.
# The user owns /workspace so tar delivery, git worktrees and test runs all
# work without root; pip installs from workspace code fall back to --user
# (the home directory is writable).
RUN useradd --create-home --uid 10001 poseidon \
    && chown poseidon:poseidon /workspace

USER 10001

EXPOSE 8000
ENTRYPOINT ["uvicorn", "sandbox.toolserver.app:app", "--host", "0.0.0.0", "--port", "8000"]
