# Sandbox image: toolchain prebaked because sandboxnet has zero egress.
# Build from the repo root: docker build -f Dockerfile.sandbox .
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

COPY packages/common /opt/poseidon/packages/common
COPY packages/sandbox /opt/poseidon/packages/sandbox
RUN pip install --no-cache-dir \
    /opt/poseidon/packages/common \
    /opt/poseidon/packages/sandbox \
    pytest

# Identity for local commits made inside the sandbox (no credentials involved).
RUN git config --system user.name "poseidon-sandbox" \
    && git config --system user.email "sandbox@poseidon.local" \
    && git config --system --add safe.directory /workspace

WORKDIR /workspace

EXPOSE 8000
ENTRYPOINT ["uvicorn", "sandbox.toolserver.app:app", "--host", "0.0.0.0", "--port", "8000"]
