package poseidon.authz.hello_saas

import rego.v1

# Default deny: a caller with no matching allow rule gets nothing.
default decision := {"allow": false, "rule": "default_deny"}

decision := {"allow": false, "rule": min(deny_rules)} if {
	count(deny_rules) > 0
}

decision := {"allow": true, "rule": min(allow_rules)} if {
	count(deny_rules) == 0
	count(allow_rules) > 0
}

# Run binding is verified by the gateway against the registry and arrives in
# the input. Policy never reads live data, so OPA stays a pure
# function of bundle + input and restarts are safe.
bound_to_run if {
	input.run_id != ""
	input.run_binding_verified == true
}

# Declared empty here so the entrypoint is safe for every blueprint: a
# document configuring no deny-producing policies would otherwise emit a
# bundle OPA refuses to load (`deny_rules` unsafe). Partial sets merge
# across files and an always-false rule contributes nothing.
allow_rules contains "declared_nowhere" if { false }

deny_rules contains "declared_nowhere" if { false }

# No spawn against an exhausted run budget — headroom is verified by the
# platform against the ledger and rides the input.
deny_rules contains "crew_request_no_budget" if {
	input.tool == "crew.request"
	input.budget_headroom == false
}

# At most 1 architecture request per run.
deny_rules contains "architecture_request_over_cap" if {
	input.tool == "architecture.request"
	input.architecture_requests >= 1
}

deny_rules contains "architecture_request_count_missing" if {
	input.tool == "architecture.request"
	not is_number(object.get(input, ["architecture_requests"], null))
}

dismiss_facts_complete if {
	is_boolean(input.run_live)
	is_number(input.dismissals)
	is_boolean(input.dismiss_target.open)
	is_boolean(input.dismiss_target.bootstrap)
	is_boolean(input.dismiss_target.in_flight)
}

deny_rules contains "issues_dismiss_facts_missing" if {
	input.tool == "issues.dismiss"
	not dismiss_facts_complete
}

# Only while scoping: the claimed run is a live scope run of the company.
deny_rules contains "issues_dismiss_not_scoping" if {
	input.tool == "issues.dismiss"
	input.workflow != "scope"
}

deny_rules contains "issues_dismiss_not_scoping" if {
	input.tool == "issues.dismiss"
	input.run_live == false
}

deny_rules contains "issues_dismiss_not_open" if {
	input.tool == "issues.dismiss"
	input.dismiss_target.open == false
}

# A bootstrap ticket is the heartbeat's: dismissed, it would be filed again.
deny_rules contains "issues_dismiss_bootstrap_ticket" if {
	input.tool == "issues.dismiss"
	input.dismiss_target.bootstrap == true
}

# A ticket a live run holds, or whose delivery stands, is being worked.
deny_rules contains "issues_dismiss_in_flight" if {
	input.tool == "issues.dismiss"
	input.dismiss_target.in_flight == true
}

# At most 3 dismissals per scope run.
deny_rules contains "issues_dismiss_over_cap" if {
	input.tool == "issues.dismiss"
	input.dismissals >= 3
}
