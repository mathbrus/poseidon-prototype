  "company": {
    "documents": {
      "architecture": "docs/ARCHITECTURE.md",
      "strategy": "docs/STRATEGY.md"
    },
    "name": "hello-saas",
    "namespace": "poseidon-company",
    "policies": {
      "branch_protection": {
        "allowed_pattern": "^feature/[a-z0-9-]+$",
        "protected": [
          "main"
        ]
      },
      "deny_paths": [
        ".github/workflows/"
      ]
    },
    "repo": {
      "base_ref": "main",
      "url": "github.com/example-org/hello-saas"
    },
    "vision": "A small SaaS that turns titles into URL slugs, delivered and kept green by a company of agents that never exceeds its authority."
  },
  "ephemeral_agents": [
    {
      "crew": "feature-delivery",
      "role": "implementer",
      "tools": [
        "architecture.request",
        "git.open_pr",
        "sandbox.edit_file",
        "sandbox.exec",
        "sandbox.git_bundle",
        "sandbox.list_dir",
        "sandbox.read_file",
        "sandbox.run_tests",
        "sandbox.write_file"
      ]
    },
    {
      "crew": "feature-review",
      "role": "reviewer",
      "tools": [
        "architecture.request",
        "git.comment",
        "git.read",
        "issues.comment",
        "sandbox.exec",
        "sandbox.list_dir",
        "sandbox.read_file",
        "sandbox.run_tests"
      ]
    },
    {
      "crew": "stewardship",
      "role": "steward",
      "tools": [
        "git.open_pr",
        "sandbox.edit_file",
        "sandbox.exec",
        "sandbox.git_bundle",
        "sandbox.list_dir",
        "sandbox.read_file",
        "sandbox.run_tests",
        "sandbox.write_file"
      ]
    }
  ],
  "heartbeat": {
    "conductor": "pm",
    "daily_cap_usd": 20.0,
    "max_attempts": 2,
    "max_concurrent_runs": 1,
    "max_open_tickets": 5,
    "may_start": [
      "implement",
      "review",
      "scope"
    ],
    "reconcile_minutes": 30
  },
  "humans": [
    "owner"
  ],
  "infra": {
    "egress_proxy_allowlist": [
      "files.pythonhosted.org",
      "pypi.org"
    ],
    "network_policy": {
      "default_deny": true,
      "namespace": "poseidon-company",
      "sandbox_egress_to": [
        "egress-proxy"
      ],
      "sandbox_ingress_from": [
        "mcp-gateway"
      ]
    },
    "sandbox": {
      "cpu": "1",
      "deadline_s": 3600,
      "disk": "2Gi",
      "image": "poseidon-sandbox",
      "memory": "1Gi",
      "test_command": "pytest -q",
      "workspace_dir": "/workspace"
    }
  },
  "instances": [
    {
      "agent_id": "pm-1",
      "company": "hello-saas",
      "max_concurrent_spawns": 2,
      "may_spawn": [
        "feature-delivery",
        "feature-review",
        "stewardship"
      ],
      "repo": {
        "base_ref": "main",
        "url": "github.com/example-org/hello-saas"
      },
      "role": "pm",
      "standing_name": "pm",
      "tools": [
        "issues.comment",
        "issues.create",
        "issues.dismiss",
        "issues.read"
      ],
      "vision": "A small SaaS that turns titles into URL slugs, delivered and kept green by a company of agents that never exceeds its authority."
    }
  ],
  "platform_bundle": {
    "files": {
      "platform.rego": "088593eda4e02e70c9eacbd6d135807d9a3f878557c82448de87f534ce9dfb91"
    }
  },
  "workflows": [
    {
      "crew": "feature-delivery",
      "gates": {},
      "max_verify_retries": 2,
      "name": "implement"
    },
    {
      "crew": "feature-review",
      "gates": {
        "merge": {
          "deadline_minutes": 1440
        }
      },
      "max_verify_retries": null,
      "name": "review"
    }
  ]
