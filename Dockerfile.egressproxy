# Egress proxy image (plan step 5): the owned forward proxy that enforces
# the sandbox host allowlist and audits every decision with run attribution.
# Build from the repo root: docker build -f Dockerfile.egressproxy .
FROM python:3.12-slim

COPY packages/common /opt/poseidon/packages/common
COPY packages/sandbox /opt/poseidon/packages/sandbox
RUN pip install --no-cache-dir \
    /opt/poseidon/packages/common \
    /opt/poseidon/packages/sandbox

EXPOSE 3128
CMD ["python", "-m", "sandbox.egressproxy"]
